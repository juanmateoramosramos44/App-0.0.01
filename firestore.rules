rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper security functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    // Shared sync state collection
    match /app_data/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Users & Credentials Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Rondas Diarias
    match /rounds/{roundId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Equipos e Inventarios
    match /equipments/{eqId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Incidencias
    match /incidents/{incId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Solicitudes
    match /requests/{reqId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Tareas
    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Cronogramas
    match /cronogramas/{cronId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Catch-all default rule
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
